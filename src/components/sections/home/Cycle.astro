---
import { Image } from 'astro:assets';
import disenoImg from '../../../assets/diseno-renderizado.jpeg';
import reformasImg from '../../../assets/cycle/reformas.jpg';
import materialesImg from '../../../assets/cycle/materiales.jpg';

const cycleData = [
    {
        id: '01',
        title: 'Diseño y Renderizado',
        desc: 'Asesoramiento en el diseño de los ambientes para que se adapten a tu estilo, ayudando a plasmar e imaginar la idea final.',
        img: disenoImg,
    },
    {
        id: '02',
        title: 'Reformas y Proyectos',
        desc: 'Planificación, dirección y ejecución de remodelaciones integrales con personal certificado y altamente capacitado.',
        img: reformasImg,
    },
    {
        id: '03',
        title: 'Provisión de Materiales',
        desc: 'Venta y suministro de materiales de primera línea con logística propia, mejorando los costos de tu refacción.',
        img: materialesImg,
    },
];

function splitTitle(title: string): [string, string] {
    const words = title.split(' ');
    const mid = Math.ceil(words.length / 2);
    return [words.slice(0, mid).join(' '), words.slice(mid).join(' ')];
}
---

<section id="ciclo-maestria" class="bg-linear-to-b via-neutral-900 from-black/40 to-zinc-950/60 relative z-30">
    <div class="cycle-mobile">
        {cycleData.map((item, i) => {
            const [line1, line2] = splitTitle(item.title);
            return (
                <div class="cycle-mobile-panel" data-panel-index={i}>
                    <Image
                        src={item.img}
                        alt={item.title}
                        width={900}
                        height={1200}
                        format="webp"
                        quality="mid"
                        class="cycle-mobile-bg"
                        loading={i === 0 ? 'eager' : 'lazy'}
                    />
                    <div class="cycle-mobile-overlay"></div>
                    <div class="cycle-mobile-content">
                        <span class="cycle-mobile-num">{item.id} / Solución Integral</span>
                        <div class="cycle-mobile-title">
                            <div class="clip-wrap"><span class="clip-inner">{line1}</span></div>
                            <div class="clip-wrap"><span class="clip-inner">{line2}</span></div>
                        </div>
                        <p class="cycle-mobile-desc">{item.desc}</p>
                    </div>
                </div>
            );
        })}
    </div>
    <div class="cycle-progress-bar">
        <div class="cycle-progress-fill"></div>
    </div>
    <div class="cycle-desktop">
    <div class="relative w-full h-[80dvh] md:h-screen scroll-container">
        <div class="h-screen w-full flex flex-col md:flex-row overflow-hidden">
            <div
                class="w-full md:w-1/2 h-full flex items-center justify-center  px-8 border-r border-white/5 z-20"
            >
                <div class="relative w-full max-w-lg h-64 text-wrapper">
                    {
                        cycleData.map((item, i) => (
                            <div
                                data-cycle-index={i}
                                class="cycle-text-item absolute top-0 left-0 w-full opacity-0 translate-y-8"
                            >
                                <span class="text-samana-1 tracking-[0.3em] text-xs font-mono uppercase italic">
                                    {item.id} / Solución Integral
                                </span>
                                <h3 class="text-4xl md:text-6xl font-bold mt-4 mb-6 font-serif uppercase leading-tight text-white">
                                    {item.title}
                                </h3>
                                <p class="text-gray-300 text-lg font-light leading-relaxed">
                                    {item.desc}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>

            <div class="w-full md:w-1/2 h-full relative bg-black overflow-hidden">
                <div
                    class="absolute inset-0 bg-linear-to-r from-neutral-900 to-transparent z-10 pointer-events-none"
                >
                </div>
                {
                    cycleData.map((item, i) => (
                        <Image                            
                            src={item.img}
                            alt={item.title}
                            width={900}
                            height={600}
                            format="webp"
                            quality="mid"
                            data-cycle-img={i}
                            class="cycle-img absolute inset-0 w-full h-full object-cover opacity-0 scale-110"
                            loading={i === 0 ? 'eager' : 'lazy'}                           
                        />
                    ))
                }
            </div>
        </div>
    </div>
    </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const MOBILE_QUERY = '(max-width: 1023px)';

  let mobileScrollCleanup: (() => void) | null = null;

  function initMobileCycle() {
    if (mobileScrollCleanup) { mobileScrollCleanup(); mobileScrollCleanup = null; }

    const container = document.querySelector('.cycle-mobile') as HTMLElement | null;
    const panels = Array.from(document.querySelectorAll('.cycle-mobile-panel')) as HTMLElement[];
    const progressFill = document.querySelector('.cycle-progress-fill') as HTMLElement | null;
    const bar = document.querySelector('.cycle-progress-bar') as HTMLElement | null;
    const section = document.querySelector('#ciclo-maestria') as HTMLElement | null;

    if (!container || !panels.length) return;

    ScrollTrigger.getAll().forEach(st => {
      if (st.trigger === container) st.kill();
    });

    const totalItems = panels.length;
    let lastActive = 0;

    gsap.set(panels, { opacity: 0 });
    panels.forEach((p, i) => p.classList.toggle('panel-active', i === 0));

    // Mismo mecanismo que GalleryProjects mobile (pin + scrub:1, ya probado y
    // liviano) en vez de un scroll interno propio — evita que el scroll de la
    // página y el scroll de los paneles compitan entre sí.
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: container,
        start: 'top top',
        end: () => `+=${window.innerHeight * totalItems}`,
        scrub: 1,
        pin: true,
        anticipatePin: 1,
        onUpdate: (self) => {
          const activeIndex = Math.min(Math.floor(self.progress * totalItems), totalItems - 1);
          if (activeIndex !== lastActive) {
            panels[lastActive]?.classList.remove('panel-active');
            panels[activeIndex]?.classList.add('panel-active');
            lastActive = activeIndex;
          }
          if (progressFill) progressFill.style.width = `${((activeIndex + 1) / totalItems) * 100}%`;
        },
      },
    });

    panels.forEach((panel, i) => {
      tl.to(panel, { opacity: 1, duration: 0.2, ease: 'power2.out' }, i);
      if (i < totalItems - 1) {
        tl.to(panel, { opacity: 0, duration: 0.2, ease: 'power2.in' }, i + 0.7);
      }
    });

    let sectionObs: IntersectionObserver | null = null;
    if (section && bar) {
      sectionObs = new IntersectionObserver(([entry]) => {
        bar.style.opacity = entry.isIntersecting ? '1' : '0';
      }, { threshold: 0.15 });
      sectionObs.observe(section);
    }

    mobileScrollCleanup = () => {
      sectionObs?.disconnect();
    };
  }

  function initDesktopCycle() {
    const container = document.querySelector('.scroll-container');
    const textItems = gsap.utils.toArray('.cycle-text-item');
    const imgItems = gsap.utils.toArray('.cycle-img');

    if (!container || !textItems.length) return;

    ScrollTrigger.getAll().forEach(st => {
      if (st.trigger === container) st.kill();
    });

    // Force decode well ahead of the scrub reveal — loading="lazy" alone can still
    // leave the bitmap undecoded exactly when GSAP sets opacity, causing a pop-in.
    imgItems.forEach((img: any) => {
      if (img?.decode) img.decode().catch(() => {});
    });

    const totalItems = textItems.length;

    gsap.set(textItems, { opacity: 0, y: 40 });
    gsap.set(imgItems, { opacity: 0, scale: 1.1 });

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: container,
        start: 'top top',
        end: () => `+=${window.innerHeight * totalItems}`,
        scrub: 1,
        pin: true,
        anticipatePin: 1,
      },
    });

    // Antes: fade de 0.2 + hold de 0.5 + hueco de 0.1 sin nada visible entre
    // items — eso es lo que se sentía "trabado" (mucho scroll sin respuesta
    // visual). Ahora el fade dura más (0.35) y el próximo item entra justo
    // cuando el anterior termina de salir, sin hueco muerto en el medio.
    textItems.forEach((text: any, i: number) => {
      const img = imgItems[i];
      if (!text || !img) return;

      tl.to(text, { opacity: 1, y: 0, duration: 0.35, ease: 'power2.out' }, i);
      tl.to(img, { opacity: 0.6, scale: 1, duration: 0.35, ease: 'power2.out' }, i);

      if (i < totalItems - 1) {
        tl.to(text, { opacity: 0, y: -40, duration: 0.35, ease: 'power2.in' }, i + 0.65);
        tl.to(img, { opacity: 0, scale: 1.1, duration: 0.35, ease: 'power2.in' }, i + 0.65);
      }
    });

    ScrollTrigger.refresh();
  }

  function initCycleScroll() {
    if (window.matchMedia(MOBILE_QUERY).matches) {
      initMobileCycle();
    } else {
      initDesktopCycle();
    }
  }

  document.addEventListener('astro:page-load', () => {
    requestAnimationFrame(initCycleScroll);
  });

  document.addEventListener('astro:before-swap', () => {
    if (mobileScrollCleanup) { mobileScrollCleanup(); mobileScrollCleanup = null; }
    ScrollTrigger.getAll().forEach(t => t.kill());
  });
</script>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif;
    }

    /* Optimización de hardware para animaciones fluidas */
    .cycle-text-item,
    .cycle-img {
        will-change: transform, opacity;
    }

    /* ── Layout switching ── */
    .cycle-mobile  { display: none; }
    .cycle-desktop { display: block; }

    @media (max-width: 1023px) {
        .cycle-mobile  { display: block; }
        .cycle-desktop { display: none; }
    }

    /* ── Mobile pinned container — un solo scroll (el de la página), GSAP
       mapea el progreso a qué panel se ve. Nada de overflow/scroll propio. ── */
    .cycle-mobile {
        height: 100svh;
        position: relative;
        overflow: hidden;
    }

    /* ── Panels — apilados uno sobre otro, el cross-fade lo controla GSAP
       vía opacity (sin transition acá: pelearía con los valores que GSAP
       escribe en cada frame del scrub, igual que ya nos pasó en Cycle
       desktop). ── */
    .cycle-mobile-panel {
        position: absolute;
        inset: 0;
        opacity: 0;
        overflow: hidden;
    }

    .cycle-mobile-bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transform: scale(1.08);
        transition: transform 5s ease-out;
        will-change: transform;
    }

    .cycle-mobile-panel.panel-active .cycle-mobile-bg {
        transform: scale(1.0);
    }

    .cycle-mobile-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to top,
            rgba(0, 0, 0, 0.92) 28%,
            rgba(0, 0, 0, 0.35) 65%,
            rgba(0, 0, 0, 0.12) 100%
        );
    }

    .cycle-mobile-content {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 28px 24px max(80px, env(safe-area-inset-bottom, 80px));
        z-index: 2;
    }

    /* ── Text animations ── */
    .cycle-mobile-num {
        display: block;
        font-family: 'Space Mono', monospace;
        font-size: 0.625rem;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--color-samana-1);
        margin-bottom: 12px;
        opacity: 0;
        transform: translateY(6px);
        transition: opacity 0.5s ease, transform 0.5s ease;
    }

    .clip-wrap {
        overflow: hidden;
        line-height: 1.1;
    }

    .clip-inner {
        display: block;
        font-family: 'Playfair Display', serif;
        font-size: clamp(2rem, 9vw, 3rem);
        font-weight: 700;
        color: #fff;
        text-transform: uppercase;
        transform: translateY(110%);
        transition: transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: transform;
    }

    .cycle-mobile-desc {
        font-size: 0.8125rem;
        color: rgba(255, 255, 255, 0.72);
        line-height: 1.7;
        font-weight: 300;
        margin-top: 14px;
        opacity: 0;
        transition: opacity 0.6s ease 0.38s;
    }

    /* Active state — all text reveals */
    .cycle-mobile-panel.panel-active .cycle-mobile-num {
        opacity: 1;
        transform: translateY(0);
        transition-delay: 0s;
    }

    .cycle-mobile-panel.panel-active .clip-wrap:nth-child(1) .clip-inner {
        transform: translateY(0);
        transition-delay: 0.1s;
    }

    .cycle-mobile-panel.panel-active .clip-wrap:nth-child(2) .clip-inner {
        transform: translateY(0);
        transition-delay: 0.22s;
    }

    .cycle-mobile-panel.panel-active .cycle-mobile-desc {
        opacity: 1;
    }

    /* ── Next-service peek ── */
    .cycle-mobile-peek {
        position: absolute;
        bottom: 2px;
        left: 0;
        right: 0;
        height: 50px;
        background: linear-gradient(to top, rgba(0, 0, 0, 0.5), transparent);
        display: flex;
        align-items: flex-end;
        justify-content: center;
        padding-bottom: 8px;
        z-index: 3;
        pointer-events: none;
    }

    .cycle-mobile-peek span {
        font-family: 'Space Mono', monospace;
        font-size: 0.5rem;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.22);
        animation: peekBob 2.2s ease-in-out infinite;
    }

    @keyframes peekBob {
        0%, 100% { transform: translateY(0);    opacity: 0.3; }
        50%       { transform: translateY(-3px); opacity: 0.7; }
    }

    /* ── Gold progress bar ── */
    .cycle-progress-bar {
        display: none;
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: rgba(255, 255, 255, 0.08);
        z-index: 999;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    @media (max-width: 1023px) {
        .cycle-progress-bar { display: block; }
    }

    .cycle-progress-fill {
        height: 100%;
        width: 33.3%;
        background: linear-gradient(
            to right,
            var(--color-samana-1),
            rgba(255, 215, 0, 0.55)
        );
        transition: width 0.45s ease;
    }
</style>
