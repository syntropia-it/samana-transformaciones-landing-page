---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const proyectosDestacados = await getCollection('projects');

proyectosDestacados.sort((a, b) => b.data.year - a.data.year);

const proyectosParaMostrar = proyectosDestacados.slice(0, 6);
---

<section
  id="proyectos-preview"
  class="bg-linear-to-t to-zinc-950/60 from-transparent relative z-30 border-t border-white/10 overflow-hidden pt-12 md:pt-24 pb-0 md:pb-14"
>
  <!-- Header fijo -->
  <div class="px-6 container mx-auto mb-8 md:mb-12">
    <div class="flex justify-between items-end">
      <div>
        <span class="text-xs font-serif font-bold tracking-[0.3em] text-samana-1 uppercase block mb-4">
          Portfolio
        </span>
        <h2 class="text-4xl md:text-6xl font-bold text-white font-serif">
          Proyectos Destacados
        </h2>
        <p class="text-gray-300 max-w-md mt-4">
          Desliza para ver nuestras transformaciones más emblemáticas.
        </p>
      </div>

      <a
        href="/proyectos"
        class="hidden md:inline-block border border-samana-1 text-samana-1 px-6 py-3 font-bold hover:bg-samana-1 hover:text-black transition-all hoverable"
        data-cta="view-all-projects"
      >
        Ver todos →
      </a>
    </div>
  </div>

  <!-- Track de proyectos (GSAP desktop / native scroll mobile) -->
  <div class="relative" data-projects-wrapper>
    <!-- Mobile: fade right edge — sugiere más cards -->
    <div
      class="md:hidden absolute right-0 top-0 bottom-0 w-16 pointer-events-none z-20"
      style="background:linear-gradient(to right, transparent, #040404);"
      aria-hidden="true"
    ></div>

    <div
      class="flex gap-[4vw] px-[10vw] w-max"
      data-projects-track
    >
      {proyectosParaMostrar.map((p, i) => (
        <article
          class="relative w-[70vw] md:w-[28vw] h-auto md:h-[50vh] shrink-0 group hoverable"
          data-project-card={i}
        >
          <!-- Número grande de fondo -->
          <div
            class="num-overlay absolute -top-10 md:-top-20 z-50 -left-4 md:-left-12 text-[4rem] md:text-[7rem] leading-none font-bold text-transparent opacity-30 font-serif pointer-events-none"
            aria-hidden="true"
          >
            {String(i + 1).padStart(2, '0')}
          </div>

          <!-- Link al proyecto -->
          <a
            href={`/proyectos/${String(p.slug)}`}
            class="block"
            data-cta={`project-${p.slug}`}
          >
            <!-- Imagen -->
            <div class="aspect-video overflow-hidden relative z-10 border border-white/20 group-hover:border-samana-1/40 transition-colors duration-500">
              <Image
                    src={p.data.image}
                    alt={p.data.title}
                    width={900}
                    height={600}
                    sizes="(min-width: 768px) 35vw, 60vw"
                    loading={i === 0 ? "eager" : "lazy"}
                    priority={i === 0}
                    class="w-full h-full object-cover transition-transform duration-[1.5s] ease-out group-hover:scale-105"
                  />
            </div>

            <!-- Info -->
            <div class="mt-6 flex justify-between items-end">
              <div>
                <h3 class="text-xl md:text-2xl font-bold text-white group-hover:text-samana-1 transition-colors">
                  {p.data.title}
                </h3>
                <p class="text-xs font-mono text-gray-300 uppercase mt-2">
                  {p.data.category}
                </p>
              </div>
              <div class="text-samana-1 font-mono text-sm">
                {p.data.year}
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>

  <!-- CTA mobile — flujo normal, siempre visible, con margen del card -->
  <div class="md:hidden flex justify-center px-6 mt-12 pb-12">
    <a
      href="/proyectos"
      class="inline-flex items-center gap-3 text-[11px] font-mono tracking-[0.28em] uppercase text-samana-1/50 hover:text-samana-1 transition-colors duration-500 hoverable"
      data-cta="view-all-projects-mobile"
    >
      Ver todos los proyectos
    </a>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  let ctx: gsap.Context | null = null;

  function initHorizontalScroll() {
    if (ctx) { ctx.revert(); ctx = null; }

    const track = document.querySelector('[data-projects-track]') as HTMLElement | null;
    const wrapper = document.querySelector('[data-projects-wrapper]') as HTMLElement | null;
    const section = document.querySelector('#proyectos-preview') as HTMLElement | null;

    if (!track || !section || !wrapper) return;

    // Mobile: GSAP vertical scroll → horizontal card movement (no swipe conflict)
    if (window.innerWidth < 768) {
        // Breathing room so -top-10 numbers don't clip against section top
      wrapper.style.paddingTop = '44px';

      const cards = Array.from(section.querySelectorAll('[data-project-card]')) as HTMLElement[];
      const ctaLink = section.querySelector('[data-cta="view-all-projects-mobile"]') as HTMLElement | null;
      let lastActiveIndex = 0;
      if (cards[0]) cards[0].classList.add('card-active');

      // Refresh after images load so scrollWidth is accurate (not a timing guess)
      const imgEls = Array.from(track.querySelectorAll('img')) as HTMLImageElement[];
      Promise.all(imgEls.map(img =>
        img.complete ? Promise.resolve() : new Promise<void>(resolve => {
          img.addEventListener('load', () => resolve(), { once: true });
          img.addEventListener('error', () => resolve(), { once: true });
        })
      )).then(() => ScrollTrigger.refresh());

      ctx = gsap.context(() => {
        gsap.to(track, {
          x: () => -(track.scrollWidth - window.innerWidth),
          ease: 'none',
          scrollTrigger: {
            trigger: section,
            start: 'top top',
            end: () => `+=${track.scrollWidth - window.innerWidth}`,
            pin: true,
            scrub: 1,
            invalidateOnRefresh: true,
            anticipatePin: 1,
            onUpdate: (self) => {
              const activeIndex = Math.round(self.progress * (cards.length - 1));
              if (activeIndex !== lastActiveIndex) {
                cards[lastActiveIndex]?.classList.remove('card-active');
                cards[activeIndex]?.classList.add('card-active');
                lastActiveIndex = activeIndex;
              }
              // Reveal CTA underline once the last card is reached
              if (self.progress >= 0.85 && ctaLink && !ctaLink.classList.contains('cta-visible')) {
                ctaLink.classList.add('cta-visible');
              }
            },
          },
        });
      }, section);
      return;
    }

    // Desktop: GSAP horizontal pin
    ctx = gsap.context(() => {

      const getScrollAmount = () => {
        let trackWidth = track.scrollWidth;
        return -(trackWidth - window.innerWidth);
      };

      const tween = gsap.to(track, {
        x: getScrollAmount,
        ease: 'none',
        scrollTrigger: {
          trigger: section,
          start: 'top top',
          end: () => `+=${track.scrollWidth - window.innerWidth}`,
          pin: true,
          scrub: 1,
          invalidateOnRefresh: true,
          anticipatePin: 1,
        },
      });

      // Scope to card cover images only — avoids future inline logos/badges
      const images = track.querySelectorAll('[data-project-card] .aspect-video img');
      images.forEach(img => {
        gsap.to(img, {
          ease: 'none',
          scrollTrigger: {
            trigger: img,
            containerAnimation: tween,
            start: 'left right',
            end: 'right left',
            scrub: true,
          }
        });
      });

      // Refresh after images load so pin end-point is accurate
      const imgEls = Array.from(track.querySelectorAll('img')) as HTMLImageElement[];
      Promise.all(imgEls.map(img =>
        img.complete ? Promise.resolve() : new Promise<void>(resolve => {
          img.addEventListener('load', () => resolve(), { once: true });
          img.addEventListener('error', () => resolve(), { once: true });
        })
      )).then(() => ScrollTrigger.refresh());

    }, section);
  }

  document.addEventListener('astro:page-load', () => {
    requestAnimationFrame(() => {
      initHorizontalScroll();
    });
  });

  document.addEventListener('astro:before-swap', () => {
    if (ctx) { ctx.revert(); ctx = null; }
  });
</script>

<style>
  [data-projects-track] {
    display: flex;
    width: max-content;
    height: 100%;
  }

  .num-overlay {
    -webkit-text-stroke: 2px #ffd700;
  }

  @media (min-width: 768px) {
    .num-overlay {
      -webkit-text-stroke: 2.5px #ffd700;
    }
  }


  [data-cta="view-all-projects-mobile"] {
    position: relative;
  }

  [data-cta="view-all-projects-mobile"]::after {
    content: '';
    position: absolute;
    bottom: -3px;
    left: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s ease-out;
  }

  [data-cta="view-all-projects-mobile"]:hover::after,
  [data-cta="view-all-projects-mobile"].cta-visible::after {
    transform: scaleX(1);
  }

  [data-project-card] img {
    filter: grayscale(100%);
    opacity: 0.5;
    transform: translateZ(0);
    transition: filter 0.6s ease-out, opacity 0.6s ease-out, transform 1s ease-out;
    backface-visibility: hidden;
  }

  /* Desktop: hover illumination */
  .group:hover img,
  [data-project-card]:hover img {
    filter: grayscale(0%);
    opacity: 1;
    transform: scale(1.05);
  }

  /* Mobile: center-of-viewport card illumination via GSAP progress */
  [data-project-card].card-active img {
    filter: none;
    opacity: 1;
  }
</style>
