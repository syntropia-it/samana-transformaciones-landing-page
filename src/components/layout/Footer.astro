---
import { Instagram, Phone } from "lucide-astro";

const currentYear = new Date().getFullYear();

const footerLinks = {
  servicios: [
    { name: "Reformas Integrales", href: "/servicios/reformas-integrales" },
    { name: "Proyectos Inmobiliarios", href: "/servicios/proyectos-inmobiliarios" },
    { name: "Diseño y Renderizado", href: "/servicios/diseno-renderizado" },
    { name: "Provisión de Materiales", href: "/servicios/venta-materiales" },
  ],
  empresa: [
    { name: "Sobre Nosotros", href: "/nosotros" },
    { name: "Proyectos", href: "/proyectos" },
    { name: "Blog", href: "/blog" },
    { name: "FAQ", href: "/faq" },
    { name: "Contacto", href: "/contacto" },
  ],
  legal: [
    { name: "Aviso Legal", href: "/legal" },
    { name: "Privacidad", href: "/privacidad" },
    { name: "Términos", href: "/terminos" },
  ],
};

const socialLinks = [
  {
    name: "Instagram",
    href: "https://www.instagram.com/samanatransformaciones_/",
    icon: Instagram,
  },
];
---

<footer
  class="bg-linear-to-t from-amber-900/20 to-black text-gray-400 relative z-30 overflow-hidden md:border-t md:border-dashed md:border-white/15 flex flex-col md:min-h-[min(100dvh,90vw)] md:pt-24"
>
  <!-- Email CTA — centrado -->
  <div data-footer-reveal class="relative z-10 max-w-7xl mx-auto px-6 pt-12 pb-10 flex flex-col items-center text-center border-b border-white/[0.06]">

    <!-- Brand label -->
    <p class="text-xs font-bold tracking-[0.3em] text-samana-1/60 uppercase mb-4">
      Contanos qué tenés en mente
    </p>

    <!-- Email — hero tipográfico -->
    <a
      href="mailto:samanatransformaciones@gmail.com"
      class="block text-base md:text-4xl font-bold text-white hover:text-samana-1 transition-colors duration-500 leading-none hoverable mb-5 break-all md:break-normal"
      data-cta="footer-email"
    >
      samanatransformaciones@gmail.com
    </a>

    <!-- Contacts secundarios -->
    <div class="flex items-center gap-3 text-sm text-gray-500">
      <a
        href="tel:+541179982004"
        class="flex items-center gap-1.5 hover:text-white transition-colors hoverable"
      >
        <Phone size={14} aria-hidden="true" />
        +54 11 7998-2004
      </a>
      <span class="text-gray-700 hidden sm:inline" aria-hidden="true">·</span>
      {socialLinks.map((s) => (
        <a
          href={s.href}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 hover:text-white transition-colors hoverable"
          aria-label={`Visitar ${s.name} de Samana`}
        >
          <s.icon size={14} aria-hidden="true" />
          {s.name}
        </a>
      ))}
    </div>

  </div>

  <!-- Nav grid: 2 cols mobile / 3 cols desktop -->
  <div data-footer-reveal class="relative z-10 max-w-7xl mx-auto px-6 pt-10">
    <div class="grid grid-cols-2 md:grid-cols-3 gap-8 pb-10">

      <!-- Servicios -->
      <div>
        <h3 class="text-white font-bold text-xs tracking-[0.22em] uppercase mb-4">
          Servicios
        </h3>
        <ul class="space-y-2">
          {footerLinks.servicios.map((link) => (
            <li>
              <a href={link.href} class="text-sm hover:text-white transition-colors hoverable">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Empresa -->
      <div>
        <h3 class="text-white font-bold text-xs tracking-[0.22em] uppercase mb-4">
          Empresa
        </h3>
        <ul class="space-y-2">
          {footerLinks.empresa.map((link) => (
            <li>
              <a href={link.href} class="text-sm hover:text-white transition-colors hoverable">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Legal — desktop: 3.ª col; mobile: fila horizontal debajo -->
      <div class="col-span-2 md:col-span-1">
        <h3 class="text-white font-bold text-xs tracking-[0.22em] uppercase mb-3 md:mb-4">
          Legal
        </h3>
        <ul class="flex flex-wrap gap-x-4 gap-y-1 md:flex-col md:space-y-2 md:gap-0">
          {footerLinks.legal.map((link) => (
            <li>
              <a href={link.href} class="text-sm hover:text-white transition-colors hoverable">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <!-- SAMANA watermark — ocupa el espacio libre entre el navgrid y el copyright,
       se recorta contra su propio borde inferior (no el de la pantalla), mismo
       tratamiento que FinalCTA. El copyright queda debajo, sin superponerse. -->
  <div
    class="samana-zone relative flex-1 min-h-[20vw] md:min-h-[30vw] xl:min-h-[20vw] overflow-hidden pb-3 pointer-events-none select-none z-0"
    aria-hidden="true"
  >
    <h2
      class="absolute inset-x-0 -bottom-5 sm:-bottom-10 md:-bottom-8 xl:-bottom-16 text-[25vw] font-bold leading-none tracking-tighter uppercase text-white opacity-[0.1] translate-x-[-5%]"
    >
      Samana
    </h2>
  </div>

  <!-- Copyright — espacio mínimo, sin línea ni fondo propio, sigue el degradé del footer -->
  <div class="relative z-10 max-w-7xl mx-auto px-6 pt-1 pb-4 flex justify-between items-center w-full">
    <span class="text-xs font-mono tracking-[0.12em] uppercase text-gray-700">
      © {currentYear} Samana Transformaciones. Buenos Aires, Argentina.
    </span>
  </div>
</footer>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  let samanaTrigger: ScrollTrigger | null = null;
  let contentRevealTriggers: ScrollTrigger[] = [];

  const isMobile = () => window.matchMedia('(max-width: 767px)').matches;

  // Email-CTA y nav-grid "suben y se acomodan" al entrar en vista — solo mobile
  // (en desktop el footer ya se ve bien tal cual, sin animación de entrada acá).
  // Mismo diferido por rAF que el resto de este archivo: evita que Layout.astro
  // mate el trigger apenas nace (ver comentario en applyMode).
  function applyContentReveal() {
    contentRevealTriggers.forEach((t) => t.kill());
    contentRevealTriggers = [];

    if (!isMobile()) return;

    requestAnimationFrame(() => {
      const blocks = document.querySelectorAll('[data-footer-reveal]');
      blocks.forEach((el) => {
        const tween = gsap.from(el, {
          y: 60,
          opacity: 0,
          duration: 1.4,
          ease: 'expo.out',
          scrollTrigger: {
            trigger: el,
            start: 'top 90%',
            toggleActions: 'play none none reverse',
          },
        });
        if (tween.scrollTrigger) contentRevealTriggers.push(tween.scrollTrigger);
      });
    });
  }

  function applyMode() {
    const zone = document.querySelector('.samana-zone') as HTMLElement | null;
    const h2 = zone?.querySelector('h2') ?? null;
    if (!zone || !h2) return;

    samanaTrigger?.kill();
    samanaTrigger = null;

    const isCondensed = document.body.hasAttribute('data-pre-footer');
    zone.style.display = isCondensed ? 'none' : '';
    if (isCondensed) return;

    // Layout.astro mata todos los ScrollTrigger vivos al principio de su propio
    // handler de 'astro:page-load' (limpieza de la página anterior en view
    // transitions). Si creamos el nuestro en el mismo tick, muere apenas nace.
    // Cycle.astro esquiva esto mismo difiriendo su init a un rAF — replicamos el patrón.
    requestAnimationFrame(() => {
      // El watermark es el último elemento de la página: a diferencia del data-reveal
      // global ('top 90%'), acá no queda recorrido de scroll después para cumplir ese
      // umbral. Dispara apenas asoma desde abajo, con la misma animación que FinalCTA.
      const tween = gsap.from(h2, {
        y: 80,
        opacity: 0,
        duration: 1.6,
        ease: 'expo.out',
        scrollTrigger: {
          trigger: zone,
          start: 'top bottom',
          toggleActions: 'play none none reverse',
        },
      });
      samanaTrigger = tween.scrollTrigger ?? null;
    });
  }

  document.addEventListener('astro:page-load', () => {
    applyMode();
    applyContentReveal();
  });
  document.addEventListener('astro:before-swap', () => {
    samanaTrigger?.kill();
    samanaTrigger = null;
    contentRevealTriggers.forEach((t) => t.kill());
    contentRevealTriggers = [];
  });
</script>

<style is:global>
  /* En páginas con FinalCTA previo, ese bloque ya es el cierre visual grande —
     el footer vuelve a su alto natural en vez de forzar el viewport completo. */
  @media (min-width: 768px) {
    body[data-pre-footer] footer {
      min-height: 0;
    }
  }

  /* FinalCTA ya termina en ámbar abajo (bg-linear-to-t from-amber-900/20 to-black).
     El footer condensado (sin SAMANA) repite el mismo degradé "ámbar abajo,
     negro arriba" — dos degradés iguales seguidos generan un corte brusco justo
     en la unión. Acá se invierte: ámbar arriba (continúa el FinalCTA) → negro abajo. */
  body[data-pre-footer] footer {
    background-image: linear-gradient(to bottom, rgb(120 53 15 / 0.2), black);
  }
</style>
