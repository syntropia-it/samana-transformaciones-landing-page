---
export const prerender = true;
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";

const allProjects = await getCollection("projects");
allProjects.sort((a, b) => b.data.year - a.data.year);

const pageTitle = "Nuestros Proyectos — Samana";
---

<BaseLayout
  title={pageTitle}
  description="Proyectos de reformas integrales, remodelaciones y construcción de alta gama realizados por Samana Transformaciones en Buenos Aires."
  schemaType="projects"
>
  <main class="bg-black relative mt-16 text-white overflow-hidden">
    <div class="container mx-auto px-6 pt-8 pb-4">
      <nav aria-label="breadcrumb" class="mb-8">
        <ol
          class="flex items-center gap-2 text-[10px] uppercase tracking-widest text-gray-300"
        >
          <li><a href="/" class="hover:text-samana-1">Inicio</a></li>
          <li>/</li>
          <li class="text-samana-1">Proyectos</li>
        </ol>
      </nav>
    </div>
    <header
      id="showcase-header"
      class="fixed top-30 w-full pointer-events-none select-none z-10"
    >
      <span
        class="text-samana-1 pt-8 px-15 text-xs font-mono tracking-[0.5em] uppercase block"
        data-reveal-text
      >
        Proyectos Samana
      </span>

      <h1
        class="text-[20vw] font-bold leading-none tracking-tighter uppercase opacity-[0.3] translate-x-[-5%]"
        data-reveal
      >
        Proyectos
      </h1>
    </header>

    <section
      id="horizontal-wrapper"
      class="h-screen flex items-center relative z-20"
    >
      <div
        id="projects-container"
        class="flex gap-[8vw] px-[10vw] items-center"
      >
        {
          allProjects.map((p, i) => (
            <article class="project-item shrink-0 w-[85vw] md:w-[60vw] lg:w-[45vw] group">
              <a href={`/proyectos/${String(p.slug)}`} class="block">
                <div class="relative aspect-video overflow-hidden bg-[#0a0a0a] mb-6 rounded-sm">
                  <Image
                    src={p.data.image}
                    alt={p.data.title}
                    width={1200}
                    height={675}
                    sizes="(min-width: 768px) 45vw, 85vw"
                    loading={i === 0 ? "eager" : "lazy"}
                    priority={i === 0}
                    class="w-full h-full object-cover transition-transform duration-[1.5s] ease-out group-hover:scale-105"
                  />
                </div>
                <div class="flex flex-col md:flex-row justify-between items-start pt-4 border-t border-white/20">
                  <h2 class="text-xl md:text-3xl font-bold uppercase tracking-tighter leading-tight line-clamp-2 min-h-[2.4em]">
                    {p.data.title}
                  </h2>
                  <div class="mt-2 md:mt-0 flex gap-4 items-center">
                    <span class="text-sm font-mono text-gray-300">
                      {p.data.year}
                    </span>
                  </div>
                </div>
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <footer
      id="showcase-indicator"
      class="fixed bottom-2 left-0 w-full px-12 flex justify-between items-end z-20"
    >
      <div class="flex flex-col bg-black/50 rounded-br-3xl p-3 gap-1">
        <p class="text-[10px] uppercase tracking-[0.4em] text-gray-100">
          Desplácese hacia abajo
        </p>
        <div class="text-4xl font-light font-mono" id="scroll-percentage">
          00%
        </div>
      </div>

      <div
        class="hidden md:flex gap-12 p-3 text-[10px] uppercase tracking-widest text-gray-300"
      >
        <span>Buenos Aires / AR</span>
        <a href="/blog" class="hover:text-samana-1 transition-colors">Blog ↗</a>
      </div>
    </footer>
  </main>
</BaseLayout>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initProjectsShowcase() {
    const container = document.getElementById("projects-container");
    const wrapper = document.getElementById("horizontal-wrapper");
    const percentageText = document.getElementById("scroll-percentage");
    const projectItems = document.querySelectorAll(".project-item");
    const main = document.querySelector("main");
    const showcaseHeader = document.getElementById("showcase-header");
    const showcaseIndicator = document.getElementById("showcase-indicator");

    if (!container || !wrapper) return;

    // El header y el indicador quedan fixed (idéntico a siempre) durante toda
    // la aproximación y el pin — cero cambios ahí. Solo al soltarse el pin
    // (100%) se "congelan" en su posición exacta y pasan a scrollear normal,
    // en vez de flotar para siempre sobre el footer real. El footer en sí no
    // necesita ninguna animación de entrada: entra por scroll normal y llano,
    // igual que Contact después de GalleryProjects en Home.
    function freeze(el) {
      if (!el || !main) return;
      const rect = el.getBoundingClientRect();
      const mainRect = main.getBoundingClientRect();
      el.style.position = "absolute";
      el.style.top = `${rect.top - mainRect.top}px`;
      el.style.bottom = "auto";
    }

    function unfreeze(el) {
      if (!el) return;
      el.style.position = "";
      el.style.top = "";
      el.style.bottom = "";
    }

    // En mobile el footer real no fuerza alto completo (es compacto), así que
    // el indicador —grande, con fondo propio— le queda compitiendo la
    // atención. Se desvanece por el propio progreso de la galería (mismo
    // patrón que la barrita bajo "ver más proyectos" en Home), no atado a
    // cuándo aparece el footer.
    const isMobile = () => window.matchMedia("(max-width: 767px)").matches;
    const INDICATOR_FADE_START = 0.85;

    const scrollTween = gsap.to(container, {
      x: () => -(container.scrollWidth - window.innerWidth),
      ease: "none",
      scrollTrigger: {
        trigger: wrapper,
        pin: true,
        scrub: 1,
        start: "top top",
        end: () => "+=" + container.scrollWidth,
        invalidateOnRefresh: true,
        onUpdate: (self) => {
          const progress = Math.round(self.progress * 100);
          if (percentageText)
            percentageText.innerText = `${progress.toString().padStart(2, "0")}%`;

          if (isMobile()) {
            const fade = Math.max(
              0,
              Math.min(
                1,
                (self.progress - INDICATOR_FADE_START) /
                  (1 - INDICATOR_FADE_START),
              ),
            );
            if (showcaseIndicator) showcaseIndicator.style.opacity = String(1 - fade);
          }
        },
        onLeave: () => {
          freeze(showcaseHeader);
          if (isMobile()) {
            if (showcaseIndicator) showcaseIndicator.style.display = "none";
          } else {
            freeze(showcaseIndicator);
          }
        },
        onEnterBack: () => {
          unfreeze(showcaseHeader);
          if (isMobile()) {
            if (showcaseIndicator) {
              showcaseIndicator.style.display = "";
              showcaseIndicator.style.opacity = "1";
            }
          } else {
            unfreeze(showcaseIndicator);
          }
        },
      },
    });

    projectItems.forEach((item) => {
      item.addEventListener("mouseenter", () => {
        const globalCursorText = document.getElementById("cursor-text");
        if (globalCursorText) globalCursorText.innerText = "VER";
      });

      item.addEventListener("mouseleave", () => {
        const globalCursorText = document.getElementById("cursor-text");
        if (globalCursorText) globalCursorText.innerText = "CLICK";
      });
    });
  }

  document.addEventListener("astro:page-load", initProjectsShowcase);
</script>

<style>
  #projects-container {
    will-change: transform;
    contain: layout paint;
  }

  #projects-container:hover .project-item:not(:hover) {
    filter: blur(2px) grayscale(0.8);
    opacity: 0.7;
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
</style>
